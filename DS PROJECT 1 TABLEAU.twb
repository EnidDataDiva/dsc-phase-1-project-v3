  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='INSIGHTS INTO AVIATION SAFETY: TRENDS, INJURIES, AND ERRORS'>
      <style />
      <size maxheight='1160' maxwidth='1450' minheight='560' minwidth='420' sizing-mode='range' />
      <datasources>
        <datasource caption='AviationData' name='federated.00w04ge0x0h2jp194gopd1i0xqqm' />
      </datasources>
      <datasource-dependencies datasource='federated.00w04ge0x0h2jp194gopd1i0xqqm'>
        <column datatype='string' name='[Broad.phase.of.flight]' role='dimension' type='nominal' />
        <column-instance column='[Broad.phase.of.flight]' derivation='None' name='[none:Broad.phase.of.flight:nk]' pivot='key' type='nominal' />
      </datasource-dependencies>
      <zones>
        <zone h='6800' id='30' type-v2='text' w='33310' x='31724' y='0'>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Tableau Bold' fontsize='16' underline='true'>Insights into Aviation Safety: Trends, Injuries, and Errors</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='9027' id='31' type-v2='text' w='66138' x='22069' y='7620'>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Helvetica Neue' fontsize='12'>Introduction</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>This project analyzes the NTSB aviation accident database to identify aircraft models with the lowest risk for a company considering entering the aviation market. The findings will provide actionable insights to inform purchasing decisions and operational strategies.</run>
          </formatted-text>
        </zone>
        <zone h='28136' id='32' param='horz' type-v2='layout-flow' w='31448' x='1655' y='18875' />
        <zone h='28136' id='33' name='ACCIDENT TRENDS OVER THE YEARS' w='31517' x='1586' y='18757' />
        <zone h='28019' id='34' param='horz' type-v2='layout-flow' w='31793' x='36138' y='18757' />
        <zone h='27667' id='35' name=' TOTAL INJURIES BY AIRCRAFT MAKE' w='31724' x='36069' y='18640' />
        <zone h='9144' id='36' name=' TOTAL INJURIES BY AIRCRAFT MAKE' pane-specification-id='0' param='[federated.00w04ge0x0h2jp194gopd1i0xqqm].[:Measure Names]' type-v2='color' w='10276' x='69379' y='18640' />
        <zone h='33294' id='37' param='horz' type-v2='layout-flow' w='32276' x='759' y='49238' />
        <zone h='33294' id='38' name='ACCIDENTCOUNTS BY ERROR TYPE' w='32000' x='828' y='49238' />
        <zone h='33294' id='39' param='horz' type-v2='layout-flow' w='33310' x='35172' y='49590' />
        <zone h='33294' id='40' name='ACCIDENT COUNTS BY PHASE OF FLIGHT' w='33310' x='35310' y='49472' />
        <zone h='33998' id='41' name='ACCIDENT COUNTS BY PHASE OF FLIGHT' param='[federated.00w04ge0x0h2jp194gopd1i0xqqm].[none:Broad.phase.of.flight:nk]' type-v2='filter' w='11034' x='68621' y='49472' />
        <zone h='30246' id='42' name='ACCIDENT COUNTS BY PHASE OF FLIGHT' pane-specification-id='0' param='[federated.00w04ge0x0h2jp194gopd1i0xqqm].[none:Broad.phase.of.flight:nk]' type-v2='color' w='9655' x='69655' y='51231' />
        <zone forceUpdate='true' h='13365' id='43' type-v2='text' w='98483' x='2138' y='84760'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>In summary, our analysis of aviation accident data (1962-2023) highlights critical trends that need attention:</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Enhance Training:</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> Focus on reducing mechanical and human error errors through targeted training.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Review High-Risk Models:</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> Conduct safety assessments on aircraft with higher accident rates.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Strengthen Safety in Critical Phases:</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> Emphasize protocols during takeoff and landing.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Encourage a Safety Culture:</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> Promote open communication about safety concerns.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Implementing these steps will improve aviation safety and align with our strategic goals.</run>
          </formatted-text>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='1550' minheight='1550' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='51' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='98124' id='50' param='vert' type-v2='layout-flow' w='98896' x='552' y='938'>
                <zone h='6800' id='30' type-v2='text' w='33310' x='31724' y='0'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Tableau Bold' fontsize='16' underline='true'>Insights into Aviation Safety: Trends, Injuries, and Errors</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='9027' id='31' type-v2='text' w='66138' x='22069' y='7620'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Helvetica Neue' fontsize='12'>Introduction</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>This project analyzes the NTSB aviation accident database to identify aircraft models with the lowest risk for a company considering entering the aviation market. The findings will provide actionable insights to inform purchasing decisions and operational strategies.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='280' h='27667' id='35' is-fixed='true' name=' TOTAL INJURIES BY AIRCRAFT MAKE' w='31724' x='36069' y='18640'>
