  <worksheets>
    <worksheet name=' TOTAL INJURIES BY AIRCRAFT MAKE'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' underline='true'>TOTAL INJURIES BY AIRCRAFT MAKE</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='AviationData' name='federated.00w04ge0x0h2jp194gopd1i0xqqm' />
          </datasources>
          <datasource-dependencies datasource='federated.00w04ge0x0h2jp194gopd1i0xqqm'>
            <column datatype='string' name='[Accident.Number]' role='dimension' type='nominal' />
            <column caption='Normalized Make' datatype='string' name='[Calculation_737745979848900608]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LOWER([Make])' />
            </column>
            <column caption='Total Injuries' datatype='integer' name='[Calculation_737745979863126017]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total.Fatal.Injuries] + [Total.Serious.Injuries] + [Total.Minor.Injuries]' />
            </column>
            <column datatype='string' name='[Make]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Total.Fatal.Injuries]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Total.Minor.Injuries]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Total.Serious.Injuries]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_737745979848900608]' derivation='None' name='[none:Calculation_737745979848900608:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_737745979863126017]' derivation='Sum' name='[sum:Calculation_737745979863126017:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Total.Fatal.Injuries]' derivation='Sum' name='[sum:Total.Fatal.Injuries:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Total.Minor.Injuries]' derivation='Sum' name='[sum:Total.Minor.Injuries:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Total.Serious.Injuries]' derivation='Sum' name='[sum:Total.Serious.Injuries:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
