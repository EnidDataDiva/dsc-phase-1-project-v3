                <zone h='33998' id='41' mode='checkdropdown' name='ACCIDENT COUNTS BY PHASE OF FLIGHT' param='[federated.00w04ge0x0h2jp194gopd1i0xqqm].[none:Broad.phase.of.flight:nk]' type-v2='filter' w='11034' x='68621' y='49472'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
